# Build metadata, normally set by the Docker image
APP_VERSION=dev
RELEASE_CHANNEL=dev

# Timezone used for scheduling and display
APP_TIMEZONE=Europe/London

# Bind address and port
HOST=127.0.0.1
PORT=8000

# Where the SQLite database lives (the Docker image uses /data, a volume)
DATA_DIR=./data

# Or point at a database directly; overrides DATA_DIR. SQLAlchemy URL format.
# DATABASE_URL=sqlite:////data/todo.db
